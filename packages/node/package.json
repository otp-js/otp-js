{
  "name": "@otpjs/node",
  "version": "1.0.0-next.0",
  "description": "Basic OTPJS Node implementation",
  "keywords": [
    "open-telecom",
    "otpjs"
  ],
  "author": "Zachary Hueras <zhueras@amdtelemedicine.com>",
  "type": "module",
  "homepage": "https://github.com/otp-js/otp-js#readme",
  "license": "MIT",
  "main": "lib/index.js",
  "imports": {
    "#context": "./lib/context/index.js",
    "#context/mailbox": "./lib/context/mailbox.js",
    "#symbols": "./lib/symbols.js",
    "#node": "./lib/node/index.js",
    "#node/functions": "./lib/node/functions/index.js",
    "#node/network": "./lib/node/network.js",
    "#node/registrar": "./lib/node/registrar.js",
    "#node/remote": "./lib/node/remote-node.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./symbols": "./lib/symbols.js"
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "files": [
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otp-js/otp-js.git"
  },
  "scripts": {
    "test": "mocha '__tests__/**/*.js'",
    "lint": "eslint src"
  },
  "bugs": {
    "url": "https://github.com/otp-js/otp-js/issues"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "mocha": "^11.7.5",
    "sinon": "^21.0.3",
    "sinon-chai": "^4.0.1"
  }
}
